<%= form_for(@message) do |form| %>
  <% if message.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(message.errors.count, "error") %> prohibited this message from being saved:</h2>

      <ul>
      <% message.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <table class="table table-bordered table-hover table-striped">
    <thead>
      <tr>
        <th><%= form.label 'タイトル' %></th>
        <th><%= form.text_field :title, size:100 %></th>
      </tr>
    </thead>

    <thead>
      <tr>
        <th><%= form.label '送信メッセージ' %></th>
        <th><%= form.text_field :message, size:100 %></th>
      </tr>
    </thead>

    <thead>
      <tr>
        <th><%= form.label 'クリック時の遷移先リンク' %></th>
        <th><%= form.text_field :link, size:100 %></th>
      </tr>
    </thead>

    <thead>
      <tr>
        <th><%= form.label '送信予約日時' %></th>
        <th><%= form.datetime_field :send_reservation_at, size:100 %></th>
      </tr>
    </thead>

    <thead>
      <tr>
        <th><%= form.label 'ステータス (0:未送信 1:テスト送信済み 2:ユーザ送信済み)' %></th>
        <th><%= form.select :status, Message.status.options, {}, class: 'form-control' %></th>
      </tr>
    </thead>
  </table>

  <p>
    <%= form.submit '更新する', class: "btn btn-primary px-5" %>
  </p>
<% end %>
