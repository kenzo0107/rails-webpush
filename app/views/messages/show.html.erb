<p id="notice"><%= notice %></p>

<p>
  <strong>タイトル:</strong>
  <%= @message.title %>
</p>

<p>
  <strong>メッセージ:</strong>
  <%= @message.message %>
</p>

<p>
  <strong>クリック時の遷移先リンク:</strong>
  <%= @message.link %>
</p>

