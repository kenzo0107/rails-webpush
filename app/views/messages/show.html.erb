<p id="notice"><%= notice %></p>

<table class="table table-bordered table-hover table-striped">
  <thead>
    <tr>
      <td>タイトル</td>
      <td><%= @message.title %></td>
    </tr>

    <tr>
      <td>メッセージ</td>
      <td><%= @message.message %></td>
    </tr>

    <tr>
      <td>クリック時の遷移先リンク</td>
      <td><%= @message.link %></td>
    </tr>

    <tr>
      <td>送信予約日時</td>
      <td><%= @message.send_reservation_at %></td>
    </tr>

    <tr>
      <td>ステータス</td>
      <td><%= @message.status %></td>
    </tr>

    <tr>
      <td>登録日時</td>
      <td><%= @message.created_at %></td>
    </tr>

    <tr>
      <td>更新日時</td>
      <td><%= @message.updated_at %></td>
    </tr>
  <thead>
</table>

<% if @message.status == 1 %>
<p>
  <%= button_to("WEB プッシュ送信", {controller: 'messages', action: 'show', method: :post}, class: "btn btn-lg btn-danger") %>
</p>
<% end %>

<p>
  <%= button_to("[テストユーザ向け] WEB プッシュ送信", {controller: 'messages', action: 'show', method: :post}, class: "btn btn-lg btn-success") %>
</p>


<%= link_to 'Edit', edit_message_path(@message), class: "btn btn-lg btn-warning" %> |
<%= link_to 'Back', messages_path, class: "btn btn-lg btn-primary" %>
