<h1>ログインページ</h1>

<%= form_tag user_sessions_path, method: :post do %>
  <div class="field">
    <%= label_tag :email %><br />
    <%= text_field_tag :email %>
  </div>
  <div class="field">
    <%= label_tag :password %><br />
    <%= password_field_tag :password %>
  </div>
  <div class="actions">
    <p><%= submit_tag "Login" %></p>
  </div>
<% end %>

<%= link_to 'Back', '/' %>
